# Admin panel (default :3002) talks to the Express backend (default :4001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4001
# Must be an absolute URL with protocol (e.g. https://admin.example.com). Empty/invalid values break Next metadataBase on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ── Vercel / production (REQUIRED) ───────────────────────────────────────────
# Admin is served over HTTPS. NEXT_PUBLIC_BACKEND_URL MUST use https:// or the
# browser blocks API calls as mixed-content.
# NEXT_PUBLIC_BACKEND_URL=https://souldiscover-be.vercel.app
# NEXT_PUBLIC_APP_URL=https://admin.souldiscovery.online
# After changing these, Redeploy the admin project (env is baked at build time).
